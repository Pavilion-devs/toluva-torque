[Unit]
Description=Toluva Meteora API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=toluva
Group=toluva
WorkingDirectory=/opt/toluva/current
EnvironmentFile=/etc/toluva/api.env
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/toluva

[Install]
WantedBy=multi-user.target
