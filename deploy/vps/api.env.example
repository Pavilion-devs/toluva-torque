NODE_ENV=production
PORT=8787
TOLUVA_API_HOST=127.0.0.1
TOLUVA_ALLOWED_ORIGIN=https://devnet.example.org
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_COMMITMENT=confirmed
TOLUVA_LEGACY_API_ENABLED=false
TOLUVA_REGISTRY_PATH=/var/lib/toluva/registry/registry.json
TOLUVA_METADATA_DIR=/var/lib/toluva/metadata
TOLUVA_METADATA_PUBLIC_BASE_URL=https://api.devnet.example.org
